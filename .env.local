# Required for the JARVIS chatbot
NVIDIA_API_KEY=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

# NVIDIA LLM route
JARVIS_MODEL=meta/llama-3.3-70b-instruct
JARVIS_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Local website/backend
JARVIS_PORT=8765

# Optional: only fill this if you cloned Hermes Agent
# Example: /Users/yourname/Projects/hermes-agent
HERMES_AGENT_PATH=

# Hermes toolsets, only used when HERMES_AGENT_PATH is set
JARVIS_TOOLSETS=memory,session_search,skills

# Voice recognition / Parakeet ASR
# Default below is for local Riva/Parakeet NIM
RIVA_SERVER=localhost:50051
RIVA_USE_SSL=0
RIVA_FUNCTION_ID=

# Use these instead for hosted NVIDIA Parakeet:
# RIVA_SERVER=grpc.nvcf.nvidia.com:443
# RIVA_USE_SSL=1
# RIVA_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca

RIVA_LANGUAGE=en-US
RIVA_MODEL=

# Local memory embeddings
JARVIS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local text-to-speech
JARVIS_TTS_VOICE=
JARVIS_TTS_RATE=175

# Optional chat tuning
JARVIS_TEMPERATURE=0.4
JARVIS_MAX_TOKENS=900
